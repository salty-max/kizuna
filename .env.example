# Optional locally. Vercel supplies VERCEL_PROJECT_PRODUCTION_URL during its builds.
SITE_URL=https://kizuna-green.vercel.app

# Optional cloud accounts. Use the browser-safe publishable key, never service_role.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Only needed when pushing Supabase Auth config from the CLI. Never prefix with VITE_.
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=your_discord_client_secret
