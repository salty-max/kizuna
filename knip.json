  "entry": [
    "scripts/**/*.ts",
    "src/components/ui/index.ts",
    "src/i18n/index.ts",
    "src/domain/types.ts",
    "src/domain/formations.ts",
    "src/domain/team.ts",
    "src/domain/synergy.ts",
    "src/domain/stats.ts",
    "src/domain/bonds.ts",
    "src/domain/layoutPitch.ts",
